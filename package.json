{
  "name": "telegram-bot-cloudflare-worker",
  "version": "1.0.0",
  "description": "Convert a Python Telegram bot to TypeScript and run it serverless on Cloudflare Workers",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "cloudflare-workers",
    "typescript",
    "serverless"
  ],
  "author": "Sahas Gamage",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}
